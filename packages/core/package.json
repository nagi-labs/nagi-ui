{
  "name": "@nagi-labs/nagi-ui",
  "version": "0.1.2",
  "description": "Accessible Vue component contracts with ownable, platform-first source Blueprints.",
  "keywords": [
    "accessibility",
    "components",
    "design-system",
    "vue"
  ],
  "homepage": "https://github.com/nagi-labs/nagi-ui#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nagi-labs/nagi-ui.git",
    "directory": "packages/core"
  },
  "bin": {
    "nagi-ui": "cli/nagi-ui.mjs"
  },
  "files": [
    "src",
    "dist",
    "blueprints",
    "cli",
    "components.ts",
    "nagi-css-preset.mjs",
    "style-compiler.mjs",
    "style-compiler.d.ts",
    "recipes",
    "theme"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.vue",
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./component-controls": "./src/component-controls.ts",
    "./test": {
      "types": "./src/test/index.ts",
      "default": "./dist/test/index.js"
    },
    "./definition": {
      "types": "./src/definition.ts",
      "default": "./dist/definition.js"
    },
    "./contracts/button": {
      "types": "./blueprints/button/button.definition.ts",
      "default": "./dist/contracts/button.js"
    },
    "./contracts/carousel": {
      "types": "./blueprints/carousel/carousel.definition.ts",
      "default": "./dist/contracts/carousel.js"
    },
    "./contracts/combobox": {
      "types": "./blueprints/combobox/combobox.definition.ts",
      "default": "./dist/contracts/combobox.js"
    },
    "./contracts/dialog": {
      "types": "./blueprints/dialog/dialog.definition.ts",
      "default": "./dist/contracts/dialog.js"
    },
    "./contracts/toast": {
      "types": "./blueprints/toast/toast.definition.ts",
      "default": "./dist/contracts/toast.js"
    },
    "./components": "./components.ts",
    "./nagi-css-preset": "./nagi-css-preset.mjs",
    "./style-compiler": {
      "types": "./style-compiler.d.ts",
      "default": "./style-compiler.mjs"
    },
    "./style-axes.css": "./theme/style-axes.css",
    "./base.css": "./theme/base.css",
    "./default-theme.css": "./theme/default-theme.css",
    "./styles.css": "./theme/styles.css",
    "./theme.css": "./theme/default-theme.css",
    "./blueprints/date-picker/internal/*": null,
    "./blueprints/date-range-picker/internal/*": null,
    "./blueprints/menu/internal/*": null,
    "./blueprints/*": "./blueprints/*",
    "./recipes/control-expansion.md": "./recipes/control-expansion.md",
    "./recipes/unovis/theme.css": "./recipes/unovis/theme.css",
    "./recipes/unovis/README.md": "./recipes/unovis/README.md",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:package": "vite build --config vite.package.config.ts",
    "prepack": "vp run build:package"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@internationalized/date": "^3.12.2",
    "citty": "^0.2.2"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
